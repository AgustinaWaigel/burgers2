generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("categories")
}

model Product {
  id                 String               @id @default(cuid())
  categoryId         String
  name               String
  slug               String               @unique
  description        String
  imageUrl           String?
  price              Decimal              @db.Decimal(10, 2)
  available          Boolean              @default(true)
  sortOrder          Int                  @default(0)
  category           Category             @relation(fields: [categoryId], references: [id])
  ingredients        ProductIngredient[]
  extras             ProductExtra[]
  orderItems         OrderItem[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  @@index([categoryId, available, sortOrder])
  @@map("products")
}

model Ingredient {
  id          String               @id @default(cuid())
  name        String
  description String?
  active      Boolean              @default(true)
  products    ProductIngredient[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@map("ingredients")
}

model ProductIngredient {
  productId    String
  ingredientId String
  included     Boolean   @default(true)
  removable    Boolean   @default(false)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([productId, ingredientId])
  @@map("product_ingredients")
}

model Extra {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  active      Boolean        @default(true)
  products    ProductExtra[]
  orderExtras OrderItemExtra[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@map("extras")
}

model ProductExtra {
  productId String
  extraId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  extra     Extra   @relation(fields: [extraId], references: [id])
  @@id([productId, extraId])
  @@map("product_extras")
}

model Promotion {
  id          String   @id @default(cuid())
  name        String
  description String?
  code        String?  @unique
  kind        String
  value       Decimal  @db.Decimal(10, 2)
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("promotions")
}

model Order {
  id              String       @id @default(cuid())
  code            String       @unique
  requestId       String?      @unique
  requestHash     String?
  receipt         Json?
  deliveryZone    String?
  discount        Decimal      @default(0) @db.Decimal(10, 2)
  promotionName   String?
  promotionCode   String?
  customerName    String
  customerPhone   String
  deliveryMethod  String
  address         String?
  paymentMethod   String
  cashAmount      Decimal?     @db.Decimal(10, 2)
  notes           String?
  subtotal        Decimal      @db.Decimal(10, 2)
  deliveryCost    Decimal      @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  status          String       @default("PENDING")
  items           OrderItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  unitPrice    Decimal         @db.Decimal(10, 2)
  quantity     Int
  removedItems String[]
  notes        String?
  subtotal     Decimal         @db.Decimal(10, 2)
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  extras       OrderItemExtra[]
  @@map("order_items")
}

model OrderItemExtra {
  id          String     @id @default(cuid())
  orderItemId String
  extraId     String
  name        String
  unitPrice   Decimal    @db.Decimal(10, 2)
  quantity    Int        @default(1)
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  extra       Extra      @relation(fields: [extraId], references: [id])
  @@map("order_item_extras")
}

model StoreSettings {
  id             String   @id @default(cuid())
  businessName   String
  whatsappNumber String
  address        String?
  hours          Json
  deliveryCost   Decimal  @db.Decimal(10, 2)
  minimumOrder   Decimal  @db.Decimal(10, 2)
  socialLinks    Json
  paymentMethods String[]
  deliveryZones  String[]
  updatedAt      DateTime @updatedAt
  @@map("store_settings")
}